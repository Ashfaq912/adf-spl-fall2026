{
	"name": "source_to_sql_pl",
	"properties": {
		"activities": [
			{
				"name": "copy_csv_to_sql",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "source_file",
								"value": {
									"value": "@pipeline().parameters.src_file",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "License Issue Date"
								},
								"sink": {
									"name": "license_issue_date"
								}
							},
							{
								"source": {
									"name": "License Number"
								},
								"sink": {
									"name": "license_number"
								}
							},
							{
								"source": {
									"name": "Animal's Name"
								},
								"sink": {
									"name": "animal_name"
								}
							},
							{
								"source": {
									"name": "Species"
								},
								"sink": {
									"name": "species"
								}
							},
							{
								"source": {
									"name": "Primary Breed"
								},
								"sink": {
									"name": "primary_breed"
								}
							},
							{
								"source": {
									"name": "Secondary Breed"
								},
								"sink": {
									"name": "secondary_breed"
								}
							},
							{
								"source": {
									"name": "ZIP Code"
								},
								"sink": {
									"name": "zip_code"
								}
							},
							{
								"source": {
									"name": "source_file"
								},
								"sink": {
									"name": "source_file"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "ds_csv_src",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.src_container",
								"type": "Expression"
							},
							"folder": {
								"value": "@pipeline().parameters.src_folder",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.src_file",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_table",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": {
								"value": "@pipeline().parameters.tgt_schema",
								"type": "Expression"
							},
							"table_name": {
								"value": "@pipeline().parameters.tgt_table",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"src_container": {
				"type": "string"
			},
			"src_folder": {
				"type": "string"
			},
			"src_file": {
				"type": "string"
			},
			"tgt_schema": {
				"type": "string"
			},
			"tgt_table": {
				"type": "string"
			}
		},
		"annotations": []
	}
}